KEENABLE_API_KEY=keen_your_key
# Anthropic API key used for query planning and extraction
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5-5
# Optional smaller model for the query-variant planner only; empty uses LLM_MODEL
LLM_PLANNER_MODEL=
# low | medium | high. Higher is more careful and slower.
LLM_EFFORT=low
# off = no thinking (Sonnet 5.5 only). Measured slower than adaptive thinking at low effort, so left empty
LLM_THINKING=
# 1 turns on Opus fast mode (research preview, about 2x the token price)
LLM_FAST=
# Blind judge that compares the two providers' results; off disables it
JUDGE_MODEL=claude-sonnet-5-5
# Side-by-side provider shown in the UI: tavily or exa
COMPARE_PROVIDER=tavily
COMPARE_API_KEY=
# Shared password for the deployed demo. Empty means no password.
DEMO_PASSWORD=
# Per-visitor checks or judge calls per 10 minutes, and a cap across all visitors per hour
RATE_LIMIT_PER_10_MIN=30
GLOBAL_LIMIT_PER_HOUR=300
MAX_QUERIES_PER_CHECK=10
# realtime (default) or pro
SEARCH_MODE=realtime
MAX_FETCHES_PER_CHECK=10
# Languages for native-language query variants (ISO 639-1, comma separated)
QUERY_LANGUAGES=zh
